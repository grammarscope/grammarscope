<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:fillViewport="true">

	<androidx.constraintlayout.widget.ConstraintLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingStart="@dimen/activity_horizontal_padding"
		android:paddingEnd="@dimen/activity_horizontal_padding">

		<ImageView
			android:id="@+id/img_up"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:contentDescription="@string/download_up"
			android:src="@drawable/ic_download_source"
			app:layout_constraintBottom_toTopOf="@id/up_header"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toTopOf="parent"
			app:layout_constraintVertical_chainStyle="packed"
			app:tint="?android:attr/colorForeground" />

		<TextView
			android:id="@+id/up_header"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:text="@string/download_up"
			android:textStyle="bold"
			app:layout_constraintBottom_toTopOf="@id/up_src"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/img_up" />

		<TextView
			android:id="@+id/up_src"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:text="@string/status_state_unknown"
			android:textStyle="italic"
			app:layout_constraintBottom_toTopOf="@id/lbl_up_size"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/up_header" />

		<TextView
			android:id="@+id/lbl_up_size"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/size"
			app:layout_constraintBottom_toTopOf="@id/lbl_up_date"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/up_src" />

		<TextView
			android:id="@+id/up_size"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="5dp"
			android:text="@string/status_state_unknown"
			app:layout_constraintBaseline_toBaselineOf="@id/lbl_up_size"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toEndOf="@id/lbl_up_size" />

		<TextView
			android:id="@+id/lbl_up_date"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/date"
			app:layout_constraintBottom_toTopOf="@id/lbl_up_etag"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/lbl_up_size" />

		<TextView
			android:id="@+id/up_date"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="5dp"
			android:text="@string/status_state_unknown"
			app:layout_constraintBaseline_toBaselineOf="@id/lbl_up_date"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toEndOf="@id/lbl_up_date" />

		<TextView
			android:id="@+id/lbl_up_etag"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/etag"
			app:layout_constraintBottom_toTopOf="@id/lbl_up_version"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/lbl_up_date" />

		<TextView
			android:id="@+id/up_etag"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="5dp"
			android:text="@string/status_state_unknown"
			app:layout_constraintBaseline_toBaselineOf="@id/lbl_up_etag"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toEndOf="@id/lbl_up_etag" />

		<TextView
			android:id="@+id/lbl_up_version"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/version"
			app:layout_constraintBottom_toTopOf="@id/lbl_up_static_version"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/lbl_up_etag" />

		<TextView
			android:id="@+id/up_version"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="5dp"
			android:text="@string/status_state_unknown"
			app:layout_constraintBaseline_toBaselineOf="@id/lbl_up_version"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toEndOf="@id/lbl_up_version" />

		<TextView
			android:id="@+id/lbl_up_static_version"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/static_version"
			app:layout_constraintBottom_toTopOf="@id/img_down"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/lbl_up_version" />

		<TextView
			android:id="@+id/up_static_version"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="5dp"
			android:text="@string/status_state_unknown"
			app:layout_constraintBaseline_toBaselineOf="@id/lbl_up_static_version"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toEndOf="@id/lbl_up_static_version" />

		<ImageView
			android:id="@+id/img_down"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="10dp"
			android:contentDescription="@string/download_down"
			android:src="@drawable/ic_download_dest"
			app:layout_constraintBottom_toTopOf="@id/down_header"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/lbl_up_static_version"
			app:tint="?android:attr/colorForeground" />

		<TextView
			android:id="@+id/down_header"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:drawablePadding="10dp"
			android:text="@string/download_down"
			android:textStyle="bold"
			app:layout_constraintBottom_toTopOf="@id/down_datapack"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/img_down" />

		<TextView
			android:id="@+id/down_datapack"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:text="@string/status_state_unknown"
			app:layout_constraintBottom_toTopOf="@id/down_source"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/down_header" />

		<TextView
			android:id="@+id/down_source"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:text="@string/status_state_unknown"
			android:textStyle="italic"
			app:layout_constraintBottom_toTopOf="@id/lbl_down_datapack_size"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/down_datapack" />

		<TextView
			android:id="@+id/lbl_down_datapack_size"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/local_size"
			app:layout_constraintBottom_toTopOf="@id/lbl_down_datapack_date"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/down_source" />

		<TextView
			android:id="@+id/down_datapack_size"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="5dp"
			android:text="@string/status_state_unknown"
			app:layout_constraintBaseline_toBaselineOf="@id/lbl_down_datapack_size"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toEndOf="@id/lbl_down_datapack_size" />

		<TextView
			android:id="@+id/lbl_down_datapack_date"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/local_date"
			app:layout_constraintBottom_toTopOf="@id/lbl_down_source_size"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/lbl_down_datapack_size" />

		<TextView
			android:id="@+id/down_datapack_date"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="5dp"
			android:text="@string/status_state_unknown"
			app:layout_constraintBaseline_toBaselineOf="@id/lbl_down_datapack_date"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toEndOf="@id/lbl_down_datapack_date" />

		<TextView
			android:id="@+id/lbl_down_source_size"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/size"
			app:layout_constraintBottom_toTopOf="@id/lbl_down_source_date"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/lbl_down_datapack_date" />

		<TextView
			android:id="@+id/down_source_size"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="5dp"
			android:text="@string/status_state_unknown"
			app:layout_constraintBaseline_toBaselineOf="@id/lbl_down_source_size"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toEndOf="@id/lbl_down_source_size" />

		<TextView
			android:id="@+id/lbl_down_source_date"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/date"
			app:layout_constraintBottom_toTopOf="@id/lbl_down_source_etag"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/lbl_down_source_size" />

		<TextView
			android:id="@+id/down_source_date"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="5dp"
			android:text="@string/status_state_unknown"
			app:layout_constraintBaseline_toBaselineOf="@id/lbl_down_source_date"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toEndOf="@id/lbl_down_source_date" />

		<TextView
			android:id="@+id/lbl_down_source_etag"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/etag"
			app:layout_constraintBottom_toTopOf="@id/lbl_down_source_version"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/lbl_down_source_date" />

		<TextView
			android:id="@+id/down_source_etag"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="5dp"
			android:text="@string/status_state_unknown"
			app:layout_constraintBaseline_toBaselineOf="@id/lbl_down_source_etag"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toEndOf="@id/lbl_down_source_etag" />

		<TextView
			android:id="@+id/lbl_down_source_version"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/version"
			app:layout_constraintBottom_toTopOf="@id/lbl_down_source_static_version"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/lbl_down_source_etag" />

		<TextView
			android:id="@+id/down_source_version"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="5dp"
			android:text="@string/status_state_unknown"
			app:layout_constraintBaseline_toBaselineOf="@id/lbl_down_source_version"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toEndOf="@id/lbl_down_source_version" />

		<TextView
			android:id="@+id/lbl_down_source_static_version"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/static_version"
			app:layout_constraintBottom_toTopOf="@id/newer"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/lbl_down_source_version" />

		<TextView
			android:id="@+id/down_source_static_version"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="5dp"
			android:text="@string/status_state_unknown"
			app:layout_constraintBaseline_toBaselineOf="@id/lbl_down_source_static_version"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toEndOf="@id/lbl_down_source_static_version" />

		<TextView
			android:id="@+id/newer"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:text="@string/status_state_unknown"
			app:layout_constraintBottom_toTopOf="@id/updateButton"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/lbl_down_source_static_version" />

		<include
			android:id="@+id/updateButton"
			layout="@layout/button_update"
			android:layout_width="64dp"
			android:layout_height="64dp"
			android:layout_marginTop="@dimen/button_margin"
			android:layout_marginBottom="@dimen/download_vertical_margin"
			android:visibility="invisible"
			app:layout_constraintBottom_toBottomOf="parent"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/newer" />

	</androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
